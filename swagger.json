            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": [
          "Clubs"
        ],
        "summary": "Delete a club",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the club"
          }
        ],
        "responses": {
          "200": {
            "description": "Club deleted"
          },
          "400": {
            "description": "Invalid id format"
          },
          "404": {
            "description": "Club not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "definitions": {
    "Player": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "example": "Lionel"
        },
        "lastName": {
          "type": "string",
          "example": "Messi"
        },
        "position": {
          "type": "string",
          "example": "Forward"
        },
        "jerseyNumber": {
          "type": "number",
          "example": 10
        },
        "birthDate": {
          "type": "string",
          "example": "1987-06-24"
        },
        "birthPlace": {
          "type": "string",
          "example": "Rosario, Santa Fe"
        },
        "currentClub": {
          "type": "string",
          "example": "Inter Miami CF"
        },
        "internationalCaps": {
          "type": "number",
          "example": 190
        },
        "internationalGoals": {
          "type": "number",
          "example": 112
        },
        "worldCupWinner": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Club": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Rosario Central"
        },
        "city": {
          "type": "string",
          "example": "Rosario"
        },
        "country": {
          "type": "string",
          "example": "Argentina"
        },
        "league": {
          "type": "string",
          "example": "Liga Profesional"
        },
        "stadium": {
          "type": "string",
          "example": "Gigante de Arroyito"
        },
        "founded": {
          "type": "number",
          "example": 1889
        }
      }
    }
  }
}