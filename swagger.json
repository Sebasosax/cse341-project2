{
  "swagger": "2.0",
  "info": {
    "title": "Argentine Football API",
    "description": "REST API for managing Argentine football players (2022 World Cup champions) and their clubs. CSE 341 Project 2.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "tags": [
    {
      "name": "Players",
      "description": "Argentine national team players"
    },
    {
      "name": "Clubs",
      "description": "Clubs where the players currently play"
    }
  ],
  "schemes": [
    "http"
  ],
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/players/": {
      "get": {
        "tags": [
          "Players"
        ],
        "summary": "Get all players",
        "description": "",
        "responses": {
          "200": {
            "description": "List of players",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Player"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": [
          "Players"
        ],
        "summary": "Create a new player",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Player data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Player"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Player created"
          },
          "400": {
            "description": "Validation error"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/players/{id}": {
      "get": {
        "tags": [
          "Players"
        ],
        "summary": "Get a player by id",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the player"
          }
        ],
        "responses": {
          "200": {
            "description": "Player found",
            "schema": {
              "$ref": "#/definitions/Player"
            }
          },
          "400": {
            "description": "Invalid id format"
          },
          "404": {
            "description": "Player not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "tags": [
          "Players"
        ],
        "summary": "Update an existing player",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the player"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated player data (all fields)",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Player"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player updated"
          },
          "400": {
            "description": "Invalid id format or validation error"
          },
          "404": {
            "description": "Player not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "tags": [
          "Players"
        ],
        "summary": "Delete a player",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the player"
          }
        ],
        "responses": {
          "200": {
            "description": "Player deleted"
          },
          "400": {
            "description": "Invalid id format"
          },
          "404": {
            "description": "Player not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/clubs/": {
      "get": {
        "tags": [
          "Clubs"
        ],
        "summary": "Get all clubs",
        "description": "",
        "responses": {
          "200": {
            "description": "List of clubs",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Club"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": [
          "Clubs"
        ],
        "summary": "Create a new club",
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Club data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Club"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Club created"
          },
          "400": {
            "description": "Validation error"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/clubs/{id}": {
      "get": {
        "tags": [
          "Clubs"
        ],
        "summary": "Get a club by id",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the club"
          }
        ],
        "responses": {
          "200": {
            "description": "Club found",
            "schema": {
