{
  "swagger": "2.0",
  "info": {
    "title": "Argentine Football API",
    "description": "REST API for managing Argentine football players (2022 World Cup champions) and their clubs. CSE 341 Project 2.\n\nGET routes are public. POST, PUT and DELETE routes are protected with GitHub OAuth: open /login in a new tab, authorize with GitHub, then come back and use the protected routes. Open /logout to end the session.",
    "version": "1.0.0"
  },
  "host": "localhost:3000",
  "basePath": "/",
  "tags": [
    {
      "name": "Authentication",
      "description": "GitHub OAuth login and logout (open these URLs in the browser)"
    },
    {
      "name": "Players",
      "description": "Argentine national team players"
    },
    {
      "name": "Clubs",
      "description": "Clubs where the players currently play"
    }
  ],
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "githubSession": {
      "type": "apiKey",
      "in": "header",
      "name": "Cookie",
      "description": "GitHub OAuth session. Open /login in a new browser tab and authorize with GitHub. The session cookie (connect.sid) is then sent automatically with every request, so nothing needs to be entered here."
    }
  },
  "paths": {
    "/login": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log in with GitHub",
        "description": "Redirects to GitHub to authorize the app. Open this URL directly in a new browser tab (Try it out cannot follow the GitHub redirect). On first login a user account is created in the users collection.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub authorization page"
          }
        }
      }
    },
    "/logout": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Log out",
        "description": "Ends the session and redirects to the home page. Open this URL directly in the browser.",
        "responses": {
          "302": {
            "description": "Redirect to home page after logout"
          }
        }
      }
    },
    "/players/": {
      "get": {
        "tags": [
          "Players"
        ],
        "summary": "Get all players",
        "description": "",
        "responses": {
          "200": {
            "description": "List of players",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Player"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": [
          "Players"
        ],
        "summary": "Create a new player",
        "description": "Requires login. Open /login in a new tab, authorize with GitHub, then try again.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Player data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Player"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Player created"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized - log in with GitHub at /login first"
          },
          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "githubSession": []
          }
        ]
      }
    },
    "/players/{id}": {
      "get": {
        "tags": [
          "Players"
        ],
        "summary": "Get a player by id",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the player"
          }
        ],
        "responses": {
          "200": {
            "description": "Player found",
            "schema": {
              "$ref": "#/definitions/Player"
            }
          },
          "400": {
            "description": "Invalid id format"
          },
          "404": {
            "description": "Player not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "tags": [
          "Players"
        ],
        "summary": "Update an existing player",
        "description": "Requires login. Open /login in a new tab, authorize with GitHub, then try again.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the player"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated player data (all fields)",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Player"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Player updated"
          },
          "400": {
            "description": "Invalid id format or validation error"
          },
          "401": {
            "description": "Unauthorized - log in with GitHub at /login first"
          },
          "404": {
            "description": "Player not found"
          },
          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "githubSession": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Players"
        ],
        "summary": "Delete a player",
        "description": "Requires login. Open /login in a new tab, authorize with GitHub, then try again.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the player"
          }
        ],
        "responses": {
          "200": {
            "description": "Player deleted"
          },
          "400": {
            "description": "Invalid id format"
          },
          "401": {
            "description": "Unauthorized - log in with GitHub at /login first"
          },
          "404": {
            "description": "Player not found"
          },
          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "githubSession": []
          }
        ]
      }
    },
    "/clubs/": {
      "get": {
        "tags": [
          "Clubs"
        ],
        "summary": "Get all clubs",
        "description": "",
        "responses": {
          "200": {
            "description": "List of clubs",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Club"
              },
              "xml": {
                "name": "main"
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "tags": [
          "Clubs"
        ],
        "summary": "Create a new club",
        "description": "Requires login. Open /login in a new tab, authorize with GitHub, then try again.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Club data",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Club"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Club created"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Unauthorized - log in with GitHub at /login first"
          },
          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "githubSession": []
          }
        ]
      }
    },
    "/clubs/{id}": {
      "get": {
        "tags": [
          "Clubs"
        ],
        "summary": "Get a club by id",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the club"
          }
        ],
        "responses": {
          "200": {
            "description": "Club found",
            "schema": {
              "$ref": "#/definitions/Club"
            }
          },
          "400": {
            "description": "Invalid id format"
          },
          "404": {
            "description": "Club not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "tags": [
          "Clubs"
        ],
        "summary": "Update an existing club",
        "description": "Requires login. Open /login in a new tab, authorize with GitHub, then try again.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the club"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated club data (all fields)",
            "required": true,
            "schema": {
              "$ref": "#/definitions/Club"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Club updated"
          },
          "400": {
            "description": "Invalid id format or validation error"
          },
          "401": {
            "description": "Unauthorized - log in with GitHub at /login first"
          },
          "404": {
            "description": "Club not found"
          },
          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "githubSession": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Clubs"
        ],
        "summary": "Delete a club",
        "description": "Requires login. Open /login in a new tab, authorize with GitHub, then try again.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "MongoDB ObjectId of the club"
          }
        ],
        "responses": {
          "200": {
            "description": "Club deleted"
          },
          "400": {
            "description": "Invalid id format"
          },
          "401": {
            "description": "Unauthorized - log in with GitHub at /login first"
          },
          "404": {
            "description": "Club not found"
          },
          "500": {
            "description": "Server error"
          }
        },
        "security": [
          {
            "githubSession": []
          }
        ]
      }
    }
  },
  "definitions": {
    "Player": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "example": "Lionel"
        },
        "lastName": {
          "type": "string",
          "example": "Messi"
        },
        "position": {
          "type": "string",
          "example": "Forward"
        },
        "jerseyNumber": {
          "type": "number",
          "example": 10
        },
        "birthDate": {
          "type": "string",
          "example": "1987-06-24"
        },
        "birthPlace": {
          "type": "string",
          "example": "Rosario, Santa Fe"
        },
        "currentClub": {
          "type": "string",
          "example": "Inter Miami CF"
        },
        "internationalCaps": {
          "type": "number",
          "example": 190
        },
        "internationalGoals": {
          "type": "number",
          "example": 112
        },
        "worldCupWinner": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "Club": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Rosario Central"
        },
        "city": {
          "type": "string",
          "example": "Rosario"
        },
        "country": {
          "type": "string",
          "example": "Argentina"
        },
        "league": {
          "type": "string",
          "example": "Liga Profesional"
        },
        "stadium": {
          "type": "string",
          "example": "Gigante de Arroyito"
        },
        "founded": {
          "type": "number",
          "example": 1889
        }
      }
    }
  }
}