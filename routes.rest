### ===== PLAYERS (LOCAL) =====

### Get all players
GET {{local}}/players

### Get player by id (Messi)
GET {{local}}/players/6ab5cdfdf6897a7d5d1d3708

### Player not found (valid format, doesn't exist)
GET {{local}}/players/6ab5cdfdf6897a7d5d1d3799

### Invalid id format
GET {{local}}/players/123

### Create player
POST {{local}}/players
Content-Type: application/json

{
  "firstName": "Lautaro",
  "lastName": "Martínez",
  "position": "Forward",
  "jerseyNumber": 22,
  "birthDate": "1997-08-22",
  "birthPlace": "Bahía Blanca, Buenos Aires",
  "currentClub": "Inter Milan",
  "internationalCaps": 70,
  "internationalGoals": 35,
  "worldCupWinner": true
}

### Update player (Di María)
PUT {{local}}/players/6ab5cdfdf6897a7d5d1d3707
Content-Type: application/json

{
  "firstName": "Ángel",
  "lastName": "Di María",
  "position": "Winger",
  "jerseyNumber": 11,
  "birthDate": "1988-02-14",
  "birthPlace": "Rosario, Santa Fe",
  "currentClub": "Rosario Central",
  "internationalCaps": 145,
  "internationalGoals": 31,
  "worldCupWinner": true
}

### Delete player (replace with the id returned by the POST)
DELETE {{local}}/players/REPLACE_WITH_ID

### Validation error - empty body
POST {{local}}/players
Content-Type: application/json

{}

### Validation error - bad values
POST {{local}}/players
Content-Type: application/json

{
  "firstName": "L",
  "lastName": "Messi",
  "position": "Striker",
  "jerseyNumber": 150,
  "birthDate": "2090-01-01",
  "birthPlace": "Rosario, Santa Fe",
  "currentClub": "Inter Miami CF",
  "internationalCaps": -5,
  "internationalGoals": "many",
  "worldCupWinner": "yes"
}

### ===== CLUBS (LOCAL) =====

### Get all clubs
GET {{local}}/clubs

### Get club by id (Rosario Central)
GET {{local}}/clubs/6ab5d54d432372731c1bf9c1

### Club not found
GET {{local}}/clubs/6ab5d54d432372731c1bf999

### Create club
POST {{local}}/clubs
Content-Type: application/json

{
  "name": "Inter Milan",
  "city": "Milan",
  "country": "Italy",
  "league": "Serie A",
  "stadium": "San Siro",
  "founded": 1908
}

### Update club (Rosario Central)
PUT {{local}}/clubs/6ab5d54d432372731c1bf9c1
Content-Type: application/json

{
  "name": "Rosario Central",
  "city": "Rosario",
  "country": "Argentina",
  "league": "Liga Profesional de Fútbol",
  "stadium": "Gigante de Arroyito",
  "founded": 1889
}

### Delete club (replace with the id returned by the POST)
DELETE {{local}}/clubs/REPLACE_WITH_ID

### Club validation error
POST {{local}}/clubs
Content-Type: application/json

{
  "name": "X",
  "founded": 3000
}

